services:
  db:
    image: postgres:17
    container_name: PROJECT_SLUG-db
    environment:
      POSTGRES_DB: DATABASE_NAME
      POSTGRES_USER: test
      POSTGRES_PASSWORD: test
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

REDIS_SERVICE
volumes:
  postgres_data:
REDIS_VOLUME
