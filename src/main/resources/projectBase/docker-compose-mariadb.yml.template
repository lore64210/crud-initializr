services:
  db:
    image: mariadb:11
    container_name: PROJECT_SLUG-db
    environment:
      MARIADB_DATABASE: DATABASE_NAME
      MARIADB_USER: test
      MARIADB_PASSWORD: test
      MARIADB_ROOT_PASSWORD: root
    ports:
      - "3306:3306"
    volumes:
      - mariadb_data:/var/lib/mysql

REDIS_SERVICE
volumes:
  mariadb_data:
REDIS_VOLUME
